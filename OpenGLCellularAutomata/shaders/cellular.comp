#version 430

layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0, rgba16ui) uniform readonly uimage2D inputImage;
layout(binding = 1, rgba16ui) uniform writeonly uimage2D outputImage;
layout(binding = 2, r32f) uniform readonly image2D uSourceMap; // static energy-generation strength per cell; never changes after map generation

// Cell layout: R = team id (0 = unclaimed), G = conductivity (see decodeConductivity/
// encodeConductivity), B = energy integer part, A = energy fractional part (1/256ths) --
// see decodeEnergy/encodeEnergy. A cell's stored energy is both its defensive reserve and
// the source of its attack power, replacing HP/attack/age-growth entirely. A cell dies only
// one way: it runs out of energy (starvation) -- whether that's from upkeep, a bad trade in
// sharing, or combat damage inflicted by hostile neighbors makes no difference, they all
// just subtract from the same pool. There's no separate "conquered" event or age/lifespan
// mortality -- a cell that starves reverts to unclaimed land and gets recontested through
// the normal reproduction path like any other empty tile. Conductivity is a per-cell memory
// of recent energy throughput that reinforces itself over time (see effectiveRate below),
// letting supply routes between a source and an active frontier organize into "trunk lines"
// rather than staying a plain, undirected diffusion gradient.
const int MAX_TEAMS = 8;

uniform uint uFrame;          // frame counter, used to seed the PRNG
uniform float uExpandChance;  // action-chance multiplier when claiming unclaimed territory

// Shared by every team -- no longer a per-archetype differentiator. What now varies between
// teams is purely behavioral: how altruistic (transferRate), reproductive, and aggressive
// each one is.
uniform float uEnergyCapacity;
uniform float uUpkeepCost;
uniform float uReproductionCostMultiplier; // shared by every team: the EXPECTED energy cost of one successful land claim is startEnergy * this, regardless of a team's reproductionWillingness (see totalAttackSpend)

// Conductivity reinforcement dynamics (shared by every team, like the economy constants
// above -- a property of the world's physics, not a per-team behavioral dial).
uniform float uConductivityDecay;  // per-tick decay fraction applied to existing conductivity
uniform float uConductivityGain;   // scales this tick's throughput into conductivity growth
uniform float uConductivityBoost;  // multiplier in effectiveRate; at max conductivity (4.0), scales the effective share rate by (1 + boost*4.0)

// Per-team behavior. transferRate = altruism: the base rate at which a cell pushes/pulls
// energy to/from a poorer/richer cardinal (N/W/E/S) same-team neighbor, before conductivity
// reinforcement (see effectiveRate) -- letting supply flow from a source out to the frontier,
// and letting whichever paths carry the most sustained flow become progressively better
// conduits. energySatisfied is the target level a cell tries to hold, NOT its maximum: a cell
// above its target pushes that surplus onward at full rate regardless of how small the local
// gap to a specific neighbor is, rather than throttling down once neighbors are close in
// value the way plain diffusion does (see the sharing section below for why).
//
// aggressionFraction is how much damage a cell deals to each
// hostile neighbor it touches: damage_i = thatNeighbor'sEnergy * aggressionFraction, summed
// across every hostile neighbor, deterministically, every tick -- no RNG, no coin flip. It
// also still sets the flat per-tick cost of maintaining that aggression (see totalAttackSpend
// below), which is a separate ledger from the damage dealt: the attacker burns its own energy
// independently of how much damage lands, rather than one funding the other. defenseFraction
// is the mirror image: a percentage reduction applied to all incoming combat damage this cell
// takes (capped well below 1.0 so it can never fully negate or invert into healing), at the
// same flat per-tick cost as aggression. reproductionWillingness plays the analogous role for
// claiming unclaimed land: it multiplies the flat uExpandChance odds of success each tick,
// so an eager team (>1.0) succeeds sooner
// on average and a reluctant team (<1.0) succeeds later -- but because the per-tick cost
// scales with that same effective chance (see totalAttackSpend below), the EXPECTED total
// cost paid before one success occurs is always startEnergy * uReproductionCostMultiplier
// (the shared global above), regardless of willingness. That keeps startEnergy and
// reproduction's economics perfectly even across teams; only how OFTEN a team reproduces
// differs.
uniform float uStartEnergy[MAX_TEAMS];             // energy a newly-claimed cell begins with
uniform float uEnergySatisfied[MAX_TEAMS];         // target energy level this team's cells push toward/shed surplus above -- see sharing section below
uniform float uTransferRate[MAX_TEAMS];            // altruism
uniform float uReproductionWillingness[MAX_TEAMS]; // multiplies uExpandChance's odds of claiming unclaimed territory
uniform float uAggressionFraction[MAX_TEAMS];      // damage dealt per hostile neighbor, and cost of maintaining it
uniform float uDefenseFraction[MAX_TEAMS];         // percentage reduction applied to incoming combat damage

// Small integer hash (Wang hash variant) for a decorrelated pseudo-random stream.
uint hash(uint x) {
    x ^= x >> 16;
    x *= 0x7feb352du;
    x ^= x >> 15;
    x *= 0x846ca68bu;
    x ^= x >> 16;
    return x;
}

// Pseudo-random float in [0,1), unique per (cell, frame, salt).
float randFloat(ivec2 coord, uint frame, uint salt) {
    uint h = hash(uint(coord.x) * 1973u + uint(coord.y) * 9277u + frame * 26699u + salt * 2971u);
    return float(h) / 4294967295.0;
}

// Combines the integer (B) and fractional (A, in 1/256ths) channels into a float energy
// value. The fractional channel exists so slow trickle transfers (well under 1.0/tick for
// low-transferRate teams) accumulate correctly instead of being truncated to 0 forever.
float decodeEnergy(uint whole, uint frac) {
    return float(whole) + float(frac) / 256.0;
}

void encodeEnergy(float energy, out uint whole, out uint frac) {
    float e = max(energy, 0.0);
    whole = uint(min(floor(e), 65535.0));
    frac = uint(clamp(fract(e) * 256.0, 0.0, 255.0));
}

// Conductivity is a single 16-bit fixed-point value (not split whole+fractional like energy)
// covering the range [0, 4.0]. Unlike energy, it's a slowly-evolving decay-then-accumulate
// memory rather than a value where sub-1.0 absolute amounts get permanently lost each tick,
// so a single scaled channel is precise enough (~0.00024 resolution).
const float CONDUCTIVITY_SCALE = 16383.0;

float decodeConductivity(uint raw) {
    return float(raw) / CONDUCTIVITY_SCALE;
}

uint encodeConductivity(float c) {
    return uint(clamp(c, 0.0, 4.0) * CONDUCTIVITY_SCALE);
}

// Boosts a team's base sharing rate by how conductive the giving cell currently is -- a cell
// that has recently relayed a lot of energy becomes a progressively better conduit.
float effectiveRate(float baseRate, float conductivity) {
    return baseRate * (1.0 + uConductivityBoost * conductivity);
}

const ivec2 OFFSETS[8] = ivec2[](
    ivec2(-1, -1), ivec2(0, -1), ivec2(1, -1),
    ivec2(-1,  0),               ivec2(1,  0),
    ivec2(-1,  1), ivec2(0,  1), ivec2(1,  1)
);

// Indices into OFFSETS/neighbors[] for the 4 cardinal directions (N, W, E, S) -- energy
// sharing only considers these, not the 4 diagonals (combat/expansion still uses all 8).
const uint CARDINAL_IDX[4] = uint[](1u, 3u, 4u, 6u);

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(inputImage);

    if (coord.x >= size.x || coord.y >= size.y) return;

    uvec4 self = imageLoad(inputImage, coord);
    uint currentOwner = self.r;
    float currentEnergy = decodeEnergy(self.b, self.a);

    // Load all 8 neighbors once; reused below for combat resolution and diffusion.
    uvec4 neighbors[8];
    for (uint idx = 0u; idx < 8u; idx++) {
        ivec2 neighborCoord = coord + OFFSETS[idx];

        // Wrap around edges (toroidal topology)
        neighborCoord.x = (neighborCoord.x + size.x) % size.x;
        neighborCoord.y = (neighborCoord.y + size.y) % size.y;

        neighbors[idx] = imageLoad(inputImage, neighborCoord);
    }

    int teamIdx = int(currentOwner) - 1; // only meaningful while currentOwner != 0u

    // Randomize scan order per-cell/frame so no direction is systematically favored.
    uint startIdx = hash(uint(coord.x) * 92821u + uint(coord.y) * 68917u + uFrame * 40699u) % 8u;

    // Reproduction: unclaimed land may get claimed by one random qualifying neighbor this
    // tick. Unchanged in spirit from before -- still probabilistic, and only reachable when
    // currentOwner == 0u (there's no energy here to erode, so combat doesn't apply).
    uint claimant = 0u;
    if (currentOwner == 0u) {
        for (uint i = 0u; i < 8u; i++) {
            uint idx = (startIdx + i) % 8u;
            uint neighborOwner = neighbors[idx].r;
            if (neighborOwner == 0u) continue;

            // No defending energy to overcome, so the odds are the flat action chance scaled
            // by the claimant's own reproductionWillingness -- an eager team claims empty land
            // faster than a reluctant one, though both pay the same EXPECTED total cost per
            // success (see totalAttackSpend below).
            int claimantTeamIdx = int(neighborOwner) - 1;
            float pWin = uExpandChance * uReproductionWillingness[claimantTeamIdx];
            float roll = randFloat(coord, uFrame, idx);
            if (roll < pWin) { claimant = neighborOwner; break; }
        }
    }

    // Combat: a claimed cell deterministically erodes under fire from every hostile neighbor
    // at once -- no RNG, no per-tick coin flip. Damage is each attacker's own energy times
    // its aggressionFraction (data already available from this cell's own 1-ring gather),
    // summed across every hostile neighbor, then reduced by this cell's own defenseFraction
    // as a straight percentage mitigation (capped well below 1.0 so an out-of-range --stats
    // override can never push it negative/healing). This is a separate ledger from the flat
    // totalAttackSpend an attacker pays just for bordering an enemy (below) -- both sides
    // burn energy independently while in contact, rather than one funding the other.
    uint unclaimedNeighborCount = 0u;
    bool hasEnemyNeighbor = false;
    float combatDamage = 0.0;
    if (currentOwner != 0u) {
        for (uint idx = 0u; idx < 8u; idx++) {
            uint neighborOwner = neighbors[idx].r;
            if (neighborOwner == currentOwner) continue;
            if (neighborOwner == 0u) { unclaimedNeighborCount++; continue; }
            hasEnemyNeighbor = true;
            float attackerEnergy = decodeEnergy(neighbors[idx].b, neighbors[idx].a);
            int attackerTeamIdx = int(neighborOwner) - 1;
            combatDamage += attackerEnergy * uAggressionFraction[attackerTeamIdx];
        }
        float mitigation = 1.0 - min(uDefenseFraction[teamIdx], 0.9);
        combatDamage *= mitigation;
    }

    // Attacker-side energy debit: committing energy toward reproduction or aggression/defense
    // costs that energy whether or not it actually pays off this tick. Aggression+defense
    // remains a single flat commitment regardless of how many enemy neighbors are touched
    // (bundled, since both trigger off the same "bordering an enemy" condition) -- the damage
    // dealt already scales with enemy-neighbor count via combatDamage above, so this maintenance
    // fee deliberately doesn't double up on that.
    //
    // Reproduction's cost, by contrast, is charged PER contested unclaimed edge (not once
    // per cell), because each unclaimed neighbor runs its own independent reproduction roll
    // (see the claimant loop above) -- a cell touching k unclaimed neighbors is simultaneously
    // entered in k separate lotteries and can win more than one in the same tick, minting a
    // fresh startEnergy on each empty cell that succeeds. A flat per-cell charge here let a
    // wide frontier (many unclaimed edges per attacker, exactly the situation at the start of
    // a run) mint far more energy via simultaneous claims than the flat fee ever paid for --
    // confirmed via the total-energy-vs-source-income check in main.cpp's
    // checkEnergyConservation(), which measured total grid energy growing ~80x faster than
    // source income could account for. Charging per unclaimed edge instead keeps the original
    // invariant (expected total spend before ONE contested edge resolves is startEnergy *
    // uReproductionCostMultiplier, independent of willingness) but now holds per-edge rather
    // than assuming at most one edge per attacker.
    float totalAttackSpend = 0.0;
    if (currentOwner != 0u) {
        if (unclaimedNeighborCount > 0u) {
            float effectiveExpandChance = uExpandChance * uReproductionWillingness[teamIdx];
            totalAttackSpend += float(unclaimedNeighborCount) * effectiveExpandChance * uStartEnergy[teamIdx] * uReproductionCostMultiplier;
        }
        if (hasEnemyNeighbor) totalAttackSpend += currentEnergy * (uAggressionFraction[teamIdx] + uDefenseFraction[teamIdx]);
        totalAttackSpend = min(totalAttackSpend, currentEnergy); // can't go into energy debt
    }

    // Per-cardinal-direction energy sharing, boosted by conductivity (see effectiveRate).
    // Two components are combined, and the STRONGER of the two wins per edge:
    //
    //  - baseShare: the original plain-diffusion term, proportional to the raw energy gap to
    //    this specific neighbor. Kept as an unconditional floor -- see below for why.
    //  - surplusShare: energy above this team's satisfaction target (uEnergySatisfied) pushed
    //    toward a poorer neighbor regardless of how small the immediate gap to them is, so an
    //    interior "trunk" cell fed from behind keeps pumping its surplus onward every tick even
    //    after locally equalizing with its neighbors, instead of settling into the flow-starved
    //    equilibrium plain diffusion produces once gaps shrink to near zero. That starvation
    //    was the original problem: it kept conductivity (needs throughput to grow) from
    //    building up along a path's whole length, confining strong flow to the single sharp
    //    gap right at an active frontier's leading tip.
    //
    // Using surplusShare ALONE (no baseShare floor) was tried first and broke the sim: every
    // freshly-claimed cell starts at startEnergy, which is below every team's satisfaction
    // target, so a newly-claimed frontier -- where most neighbors are also fresh and below
    // target -- got literally zero mutual support (neighborSurplus/selfSurplus both 0) and
    // starved en masse under nothing but upkeep, visible as territory fragmenting into
    // flickering single-pixel noise instead of stable blobs. Taking max(baseShare,
    // surplusShare) keeps the old baseline diffusion always available as a safety net, while
    // still letting genuine surplus (mainly near sources, and along paths that have built up
    // conductivity) punch well above what plain diffusion would allow.
    //
    // Both terms, and the final result, stay capped by the actual pairwise gap (min() below)
    // -- can't push/pull past what the other side actually has relative to me. Needed for
    // surplusShare specifically: pushing past the gap risks flipping who's richer in a single
    // tick, which round-trips into oscillation/flicker between adjacent cells at high
    // conductivity.
    //
    // surplusShare is divided by 4 (the max possible cardinal same-team neighbors) before
    // being applied per edge -- unlike baseShare, which is naturally self-limiting per edge (a
    // specific neighbor's gap can't exceed currentEnergy), surplus is the SAME value for every
    // qualifying edge this cell has, so applying it undivided let a cell with 2+ poorer
    // same-team neighbors pledge its *entire* surplus to each one simultaneously --
    // overcommitting routinely (any solid blob interior has ~2 poorer cardinal neighbors on
    // average once above target), not just the rare "several much-poorer neighbors at once"
    // case the totalGive safety cap below was written for. Dividing by a fixed 4 -- rather
    // than the giver's actual poorer-neighbor count, which would require reading the giver's
    // neighbors too (a second ring of texture reads) -- keeps both sides of an edge computing
    // the identical value from only their own 1-ring data, so conservation stays exact, at the
    // cost of under-spending when a cell has fewer than 4 poorer neighbors.
    //
    // The giving side of each edge always uses its OWN conductivity/surplus, and since the
    // receiver reads the giver's energy directly, "the giver's surplus" as computed by the
    // receiver and "my surplus" as computed by the giver are the same value -- so a gain on
    // one side always exactly matches a loss on the other, same conservation guarantee as
    // before. Also tracks how much is given away separately so it can still be capped --
    // defense in depth, should rarely trigger now that per-edge pushes are budgeted not to sum
    // past a cell's own surplus. grossThroughput (the sum of what actually moved, both
    // directions) is what drives this cell's own conductivity growth below.
    float netTransfer = 0.0;
    float totalGive = 0.0;
    float grossThroughput = 0.0;
    if (currentOwner != 0u) {
        float selfConductivity = decodeConductivity(self.g);
        float satisfied = uEnergySatisfied[teamIdx];
        float selfSurplus = max(currentEnergy - satisfied, 0.0);

        for (uint c = 0u; c < 4u; c++) {
            uint idx = CARDINAL_IDX[c];
            if (neighbors[idx].r != currentOwner) continue;
            float neighborEnergy = decodeEnergy(neighbors[idx].b, neighbors[idx].a);
            float neighborConductivity = decodeConductivity(neighbors[idx].g);
            float neighborSurplus = max(neighborEnergy - satisfied, 0.0);

            float share = 0.0;
            if (neighborEnergy > currentEnergy) {
                // I receive, using the GIVER's own conductivity/surplus, pre-divided across
                // its up-to-4 cardinal edges (see comment above).
                float rate = effectiveRate(uTransferRate[teamIdx], neighborConductivity);
                float baseShare = rate * (neighborEnergy - currentEnergy);
                float surplusShare = rate * neighborSurplus / 4.0;
                share = min(max(baseShare, surplusShare), neighborEnergy - currentEnergy);
            } else if (neighborEnergy < currentEnergy) {
                // I give, using MY OWN conductivity/surplus, pre-divided across my up-to-4
                // cardinal edges.
                float rate = effectiveRate(uTransferRate[teamIdx], selfConductivity);
                float baseShare = rate * (currentEnergy - neighborEnergy);
                float surplusShare = rate * selfSurplus / 4.0;
                share = -min(max(baseShare, surplusShare), currentEnergy - neighborEnergy);
            }

            netTransfer += share;
            grossThroughput += abs(share);
            if (share < 0.0) totalGive += -share;
        }
        if (totalGive > currentEnergy) {
            // Safety cap: claw back the excess so this cell can't go into debt from giving.
            // Rare in practice -- only kicks in with several much-poorer neighbors and a
            // high effective rate at once. Those neighbors still compute their own receive
            // amount independently and won't see this cap, so this is a small, accepted
            // approximation in that specific edge case rather than an exact conservation
            // guarantee.
            netTransfer += (totalGive - currentEnergy);
        }
    }

    // Conductivity update: decay-then-accumulate, using the real throughput just computed.
    // Gross (both directions summed as absolute values), not net -- a perfect mid-trunk
    // conduit both receives from the source side and gives to the frontier side
    // simultaneously, so net flow could be near zero even while gross throughput (and thus
    // reinforcement) is high.
    float newConductivity = 0.0;
    if (currentOwner != 0u) {
        float oldConductivity = decodeConductivity(self.g);
        newConductivity = clamp(
            oldConductivity * (1.0 - uConductivityDecay) + uConductivityGain * grossThroughput,
            0.0, 4.0
        );
    }

    float sourceGain = (currentOwner != 0u) ? imageLoad(uSourceMap, coord).r : 0.0;
    float upkeep = (currentOwner != 0u) ? uUpkeepCost : 0.0;

    float netEnergyChange = sourceGain + netTransfer - totalAttackSpend - upkeep - combatDamage;

    uint newOwner;
    float newEnergy;
    float finalConductivity;

    if (currentOwner == 0u) {
        if (claimant != 0u) {
            newOwner = claimant;
            newEnergy = uStartEnergy[int(claimant) - 1];
        } else {
            newOwner = 0u;
            newEnergy = 0.0;
        }
        finalConductivity = 0.0; // freshly claimed (or still empty): no relay history yet
    } else if ((currentEnergy + netEnergyChange) <= 0.0) {
        // Starved: upkeep, net sharing, attack-spend, and/or combat damage outpaced supply --
        // reverts to unclaimed land, to be recontested through the reproduction path above
        // like any other empty tile (no separate "conqueror" grant).
        newOwner = 0u;
        newEnergy = 0.0;
        finalConductivity = 0.0;
    } else {
        newOwner = currentOwner;
        newEnergy = clamp(currentEnergy + netEnergyChange, 0.0, uEnergyCapacity);
        finalConductivity = newConductivity; // held by the same team: apply the decay+accumulate update
    }

    uint newB, newA;
    encodeEnergy(newEnergy, newB, newA);
    imageStore(outputImage, coord, uvec4(newOwner, encodeConductivity(finalConductivity), newB, newA));
}
